ell-md-2","cell_type":"markdown","source":"## Cell 2 — Download or load GGUF from Kaggle dataset","metadata":{}},{"id":"cell-2","cell_type":"code","source":"import os\nos.makedirs(MODEL_DIR, exist_ok=True)\nGGUF_PATH = DATASET_PATH\nprint(f\"Loaded from dataset: {GGUF_PATH})\")\n","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"id":"cell-md-3","cell_type":"markdown","source":"## Cell 3 — Launch llama-server","metadata":{}},{"id":"4813f6e0-e214-4ae0-954a-0bea5278d97c","cell_type":"code","source":"# print(open(\"/kaggle/working/srv.log\").read()[-4000:])\n# print(\"alive:\", srv.poll() is None, \"| exit code:\", srv.poll())","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"id":"cell-md-4","cell_type":"markdown","source":"## Cell 4 — Cloudflare tunnel + print credentials","metadata":{}},{"id":"6dec354c-37eb-44a7-8c09-6f659fb30f96","cell_type":"code","source":"# !find /kaggle/working/llama.cpp/build -name \"libllama-common.so*\" -o -name \"libggml*.so*\" -o -name \"libllama.so*\" | xargs -n1 dirname | sort -u","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"id":"cell-4","cell_type":"code","source":"import os, re, glob, time, json, secrets, threading, subprocess\nimport urllib.request, urllib.error\n\n# ============================================================\n# CONFIG\n# ============================================================\nWORK = globals().get(\"WORK\", \"/kaggle/working\")\nPORT = 8080\n\n# Auto-rotate: never reuse the key you pasted in chat\nAPI_KEY = globals().get(\"API_KEY\") or secrets.token_urlsafe(32)\n\n# ============================================================\n# 1) LOCATE llama-server\n# ============================================================\nbins = glob.glob(f\"{WORK}/**/llama-server\", recursive=True) \\\n    or glob.glob(\"/kaggle/**/llama-server\", recursive=True)\nassert bins, \"llama-server binary not found — did llama.cpp build finish?\"\nBIN = bins[0]\nos.chmod(BIN, 0o755)\nprint(\"BIN     :\", BIN)\n\n# ============================================================\n# 2) LOCATE GGUF\n# ============================================================\nggufs = glob.glob(\"/kaggle/input/**/*.gguf\", recursive=True)\nassert ggufs, \"No .gguf under /kaggle/input — attach the dataset to this notebook (Add Input → Datasets).\"\nGGUF_PATH = ggufs[0]\nprint(\"GGUF    :\", GGUF_PATH)\n\n# ============================================================\n# 3) BUILD LD_LIBRARY_PATH\n# ============================================================\nrepo_root = BIN.split(\"/build/\")[0]\nLIB_DIRS = sorted({os.path.dirname(p)\n                   for p in glob.glob(f\"{repo_root}/build/**/*.so*\", recursive=True)})\nLIB_DIRS += [d for d in (\"/usr/local/lib\", \"/usr/lib/x86_64-linux-gnu\")\n             if os.path.isdir(d)]\nenv = {**os.environ,\n       \"LD_LIBRARY_PATH\": \":\".join(\n           LIB_DIRS + [os.environ.get(\"LD_LIBRARY_PATH\", \"\")]).strip(\":\")}\nprint(\"LIB_DIRS:\", LIB_DIRS)\n\n# ============================================================\n# 4) LAUNCH llama-server\n# ============================================================\nsrv_cmd = [\n    BIN,\n    \"-m\",   GGUF_PATH,\n    \"-ngl\", \"99\",\n    \"-ts\",  \"1,1\",\n    \"-c\",   \"65536\",\n    \"-np\",  \"2\",\n    \"-fa\",  \"on\",\n    \"-ctk\", \"q8_0\",\n    \"-ctv\", \"q8_0\",\n    \"--jinja\",\n    \"--temp\",  \"0.6\",\n    \"--top-p\", \"0.95\",\n    \"--top-k\", \"20\",\n    \"--host\",    \"127.0.0.1\",\n    \"--port\",    str(PORT),\n    \"--api-key\", API_KEY,\n]\n\nLOG = f\"{WORK}/srv.log\"\nsrv = subprocess.Popen(\n    srv_cmd, env=env,\n    stdout=subprocess.PIPE, stderr=subprocess.STDOUT,\n    text=True, bufsize=1,\n)\n\ndef _tee():\n    with open(LOG, \"w\") as f:\n        for line in srv.stdout:\n            f.write(line); f.flush()\n            print(line, end=\"\", flush=True)\nthreading.Thread(target=_tee, daemon=True).start()\n\nprint(\"Waiting for llama-server to become healthy ...\")\nready = False\nfor _ in range(300):                       # up to ~10 min\n    if srv.poll() is not None:\n        raise RuntimeError(f\"llama-server exited rc={srv.returncode}; see {LOG}\")\n    try:\n        urllib.request.urlopen(f\"http://127.0.0.1:{PORT}/health\", timeout=3)\n        print(\">>> llama-server ready\")\n        ready = True\n        break\n    except Exception:\n        time.sleep(2)\nassert ready, \"llama-server didn't become healthy within 10 min — see srv.log\"\n\n# ============================================================\n# 5) LAUNCH cloudflared\n# ============================================================\nCF = f\"{WORK}/cloudflared\"\nif not os.path.isfile(CF):\n    subprocess.run(\n        [\"wget\", \"-q\",\n         \"https://github.com/cloudflare/cloudflared/releases/latest/download/cloudflared-linux-amd64\",\n         \"-O\", CF],\n        check=True,\n    )\n    os.chmod(CF, 0o755)\n\ntun = subprocess.Popen(\n    [CF, \"tunnel\", \"--url\", f\"http://127.0.0.1:{PORT}\", \"--no-autoupdate\"],\n    stdout=subprocess.DEVNULL, stderr=subprocess.PIPE, text=True,\n)\n\nURL = None\nfor line in tun.stderr:\n    m = re.search(r\"https://[a-z0-9-]+\\.trycloudflare\\.com\", line)\n    if m:\n        URL = m.group(0)\n        break\nassert URL, \"Could not extract tunnel URL from cloudflared stderr\"\n\n# keep draining stderr so the pipe never blocks\nthreading.Thread(target=lambda: [None for _ in tun.stderr], daemon=True).start()\n\n# ============================================================\n# 6) VERIFY END-TO-END THROUGH THE TUNNEL\n# ============================================================\ndef probe(path, method=\"GET\", body=None, timeout=30):\n    req = urllib.request.Request(\n        f\"{URL}{path}\",\n        data=(json.dumps(body).encode() if body is not None else None),\n        method=method,\n        headers={\n            \"Authorization\": f\"Bearer {API_KEY}\",\n            \"Content-Type\": \"application/json\",\n        },\n    )\n    try:\n        with urllib.request.urlopen(req, timeout=timeout) as r:\n            return r.status, r.read()[:400]\n    except urllib.error.HTTPError as e:\n        return e.code, e.read()[:400]\n    except Exception as e:\n        return None, repr(e).encode()\n\ntime.sleep(2)  # let the tunnel route settle\nfor label, path, method, body in [\n    (\"health\", \"/health\",             \"GET\",  None),\n    (\"models\", \"/v1/models\",          \"GET\",  None),\n    (\"chat  \", \"/v1/chat/completions\",\"POST\",\n     {\"model\": \"x\",\n      \"messages\": [{\"role\": \"user\", \"content\": \"say hi in 3 words\"}],\n      \"chat_template_kwargs\": {\"enable_thinking\": False},\n      \"max_tokens\": 32}),\n]:\n    code, payload = probe(path, method, body)\n    print(f\"{label} : {code}  {payload[:160]!r}\")\n\n# ============================================================\n# 7) WATCHDOG\n# ============================================================\ndef _watch():\n    while True:\n        if srv.poll() is not None:\n            print(f\"[watchdog] llama-server died rc={srv.returncode}\"); return\n        if tun.poll() is not None:\n            print(f\"[watchdog] cloudflared  died rc={tun.returncode}\"); return\n        time.sleep(5)\nthreading.Thread(target=_watch, daemon=True).start()\n\n# ============================================================\n# 8) PRINT ACCESS INFO\n# ============================================================\nprint(\"=\" * 60)\nprint(\"BASE URL :\", URL)\nprint(\"API KEY  :\", API_KEY)\nprint(\"=\" * 60)\nprint()\nprint(\"OpenAI-compatible client:\")\nprint(f'  base_url = \"{URL}/v1\"')\nprint(f'  api_key  = \"{API_KEY}\"')\nprint()\nprint(\"curl test (non-thinking, fast):\")\nprint(f\"\"\"  curl {URL}/v1/chat/completions \\\\\n    -H \"Authorization: Bearer {API_KEY}\" \\\\\n    -H \"Content-Type: application/json\" \\\\\n    -d '{{\"model\":\"qwen\",\"messages\":[{{\"role\":\"user\",\"content\":\"hi\"}}],\n         \"chat_template_kwargs\":{{\"enable_thinking\":false}}}}'\"\"\")\n\n# ============================================================\n# 9) CLEAN SHUTDOWN HELPER\n# ============================================================\ndef shutdown():\n    for name, p in ((\"cloudflared\", tun), (\"llama-server\", srv)):\n        try:\n            p.terminate()\n            p.wait(timeout=10)\n        except Exception:\n            p.kill()\n        print(f\"{name} stopped\")","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"id":"cell-md-5","cell_type":"markdown","source":"## Cell 5 — Keep-alive (run last, keeps the session alive)","metadata":{}},{"id":"8add5e93-9d60-47de-b1e4-e27315757a70","cell_type":"code","source":"!free -h\n!grep -E '^(MemTotal|MemFree|MemAvailable|Buffers|Cached|Mapped):' /proc/meminfo\n!nvidia-smi --query-gpu=index,memory.used,memory.total --format=csv\n!grep -E '^(VmRSS|VmSize|RssFile|RssAnon):' /proc/{srv.pid}/status","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-31T00:35:10.070743Z","iopub.execute_input":"2026-10-31T00:35:10.071625Z","iopub.status.idle":"2026-10-31T00:35:10.636505Z","shell.execute_reply.started":"2026-10-31T00:35:10.071592Z","shell.execute_reply":"2026-10-31T00:35:10.635762Z"}},"outputs":[{"name":"stdout","text":"               total        used        free      shared  buff/cache   available\nMem:            31Gi       1.4Gi       7.0Gi       1.8Mi        23Gi        29Gi\nSwap:             0B          0B          0B\nMemTotal:       32869296 kB\nMemFree:         7317736 kB\nMemAvailable:   31367644 kB\nBuffers:          828668 kB\nCached:         23310100 kB\nMapped:           417212 kB\nindex, memory.used [MiB], memory.total [MiB]\n0, 0 MiB, 15360 MiB\n1, 0 MiB, 15360 MiB\ngrep: /proc/{srv.pid}/status: No such file or directory\n","output_type":"stream"}],"execution_count":1},{"id":"cell-5","cell_type":"code","source":"import time\nwhile True:\n    time.sleep(60)","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"id":"7aa5f5b7-37da-4823-affb-a411226c7c8a","cell_type":"code","source":"","metadata":{"trusted":true},"outputs":[],"execution_count":null}]}